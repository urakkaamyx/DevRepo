<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Endo.Gui</AssemblyName>
    <RootNamespace>Endo.Gui</RootNamespace>
  </PropertyGroup>

  <!--
    App.xaml would normally be auto-treated as ApplicationDefinition, which makes the WPF SDK
    generate this assembly's own Main() and turns it into a self-starting exe. Endo.Gui is now a
    library the unified `Endo` project boots itself (new App(); app.InitializeComponent(); app.Run();),
    so App.xaml is compiled as a plain Page instead — same generated InitializeComponent(), no Main.
  -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Endo.Core\Endo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
