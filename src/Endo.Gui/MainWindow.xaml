<Window x:Class="Endo.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Endo.Gui.Models"
        xmlns:commands="clr-namespace:Endo.Core.Commands;assembly=Endo.Core"
        mc:Ignorable="d"
        Title="Endo" Height="720" Width="1000" MinHeight="480" MinWidth="640"
        Background="#1E1E1E" FontFamily="Segoe UI">

    <Window.Resources>
        <DataTemplate DataType="{x:Type models:ChatMessage}">
            <Border x:Name="Bubble" Margin="12,6" Padding="14,10" CornerRadius="10"
                    MaxWidth="700" HorizontalAlignment="Left" Background="#2D2D30">
                <StackPanel>
                    <TextBlock x:Name="RoleLabel" Text="{Binding Role}" FontSize="10" FontWeight="SemiBold"
                               Foreground="#9A9A9A" Margin="0,0,0,4"/>
                    <!-- TextBox, not TextBlock: read-only + borderless so it looks identical, but
                         (unlike TextBlock) supports click-drag selection and Ctrl+C copy. -->
                    <TextBox x:Name="ContentText" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                             Foreground="#E8E8E8" FontSize="14" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             FocusVisualStyle="{x:Null}" Cursor="IBeam"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="User">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Bubble" Property="Background" Value="#2B5C8A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="Assistant">
                    <Setter TargetName="Bubble" Property="Background" Value="#233029"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#3FA37B"/>
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="Shell">
                    <Setter TargetName="Bubble" Property="Background" Value="#141414"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#C9922C"/>
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="1"/>
                    <Setter TargetName="Bubble" Property="MaxWidth" Value="900"/>
                    <Setter TargetName="ContentText" Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                    <Setter TargetName="ContentText" Property="FontSize" Value="13"/>
                    <Setter TargetName="ContentText" Property="Foreground" Value="#7FD98B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="System">
                    <Setter TargetName="Bubble" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center"/>
                    <Setter TargetName="ContentText" Property="Foreground" Value="#8A8A8A"/>
                    <Setter TargetName="ContentText" Property="FontStyle" Value="Italic"/>
                    <Setter TargetName="RoleLabel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="Error">
                    <Setter TargetName="Bubble" Property="Background" Value="#4A1E1E"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#C9524C"/>
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CommandItemTemplate" DataType="{x:Type commands:CommandDescriptor}">
            <StackPanel Margin="12,9">
                <TextBlock Text="{Binding Name}" Foreground="#7FD9E8" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Description}" Foreground="#8A8A8A" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Command sidebar -->
        <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="COMMANDS" FontSize="11" FontWeight="Bold"
                           Foreground="#6A6A6A" Margin="12,12,12,6"/>
                <TextBlock DockPanel.Dock="Top" Text="Double-click to insert a template"
                           FontSize="10" Foreground="#5A5A5A" Margin="12,0,12,8" TextWrapping="Wrap"/>
                <ListBox x:Name="CommandsList" ItemsSource="{Binding Commands}"
                         ItemTemplate="{StaticResource CommandItemTemplate}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="CommandsList_MouseDoubleClick"/>
            </DockPanel>
        </Border>

        <!-- Chat area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status bar -->
            <Border Grid.Row="0" Background="#252526" Padding="16,10" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#B0B0B0" FontSize="12" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="NewProjectButton" Content="+ New Project" Padding="10,4"
                            Background="#2B5C8A" Foreground="White" BorderThickness="0" FontSize="12"
                            Click="NewProjectButton_Click"/>
                </Grid>
            </Border>

            <!-- Chat log -->
            <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}" Margin="0,8"/>
            </ScrollViewer>

            <!-- Input bar -->
            <Border Grid.Row="2" Background="#252526" Padding="12" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputBox" Grid.Column="0"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1E1E1E" Foreground="#E8E8E8" CaretBrush="#E8E8E8"
                             BorderBrush="#3A3A3A" BorderThickness="1" Padding="10,8"
                             FontSize="14" AcceptsReturn="True" TextWrapping="Wrap"
                             MaxHeight="120" VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="InputBox_PreviewKeyDown"/>

                    <Button Grid.Column="1" Content="Send" Margin="8,0,0,0" Padding="18,8"
                            Background="#2B5C8A" Foreground="White" BorderThickness="0"
                            Command="{Binding SendCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
