<Window x:Class="Endo.Gui.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="New Project" Height="640" Width="560"
        Background="#1E1E1E" Foreground="#E8E8E8" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="CaretBrush" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="New Project" FontSize="20" FontWeight="SemiBold"/>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Category" Style="{StaticResource Label}"/>
                <ComboBox x:Name="CategoryCombo" IsEditable="True"/>

                <TextBlock Text="SubCategory (for GameModding, this is the game's name)" Style="{StaticResource Label}"/>
                <ComboBox x:Name="SubCategoryCombo" IsEditable="True"/>

                <TextBlock Text="Project name" Style="{StaticResource Label}"/>
                <TextBox x:Name="NameBox"/>

                <TextBlock Text="IDE (optional)" Style="{StaticResource Label}"/>
                <ComboBox x:Name="IdeCombo" SelectionChanged="IdeCombo_SelectionChanged"/>
                <TextBox x:Name="IdeCustomBox" Margin="0,6,0,0" Visibility="Collapsed"
                         ToolTip="Executable name or path, e.g. notepad++"/>

                <TextBlock Text="Template (optional — scaffolds starter files)" Style="{StaticResource Label}"/>
                <ComboBox x:Name="TemplateCombo"/>

                <TextBlock x:Name="RuntimeLabel" Text="Runtime (optional)" Style="{StaticResource Label}"/>
                <ComboBox x:Name="RuntimeCombo"/>

                <Border x:Name="DiscoveryPanel" Visibility="Collapsed" Background="#252526" CornerRadius="6"
                        Padding="12" Margin="0,18,0,0" BorderBrush="#3A3A3A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Modding tools found for this game" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DiscoveryStatusText" Text="Searching..." Foreground="#B0B0B0"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="CandidatesList"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusMessage" Margin="0,16,0,0" Foreground="#C9524C" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click"/>
            <Button x:Name="InstallSelectedButton" Content="Install Selected Tools" Style="{StaticResource SecondaryButton}"
                    Visibility="Collapsed" Click="InstallSelectedButton_Click"/>
            <Button x:Name="CreateButton" Content="Create Project" Padding="16,8" Background="#2B5C8A" Foreground="White"
                    BorderThickness="0" Click="CreateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
