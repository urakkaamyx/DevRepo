<Window x:Class="Endo.Gui.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Endo — First-time Setup" Height="560" Width="560"
        Background="#1E1E1E" Foreground="#E8E8E8" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="CaretBrush" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Set up Endo" FontSize="20" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="Environment location (config, tools, runtimes, DevRepo)" Style="{StaticResource Label}"/>
            <TextBox x:Name="RootBox"/>

            <TextBlock Text="Default Projects folder" Style="{StaticResource Label}"/>
            <TextBox x:Name="WorkspaceBox"/>

            <CheckBox x:Name="DevRepoCheck" Content="Initialize a private DevRepo Git repository" IsChecked="True" Margin="0,16,0,0"/>

            <TextBlock Text="Orchestrator AI provider (Endo AI — command dispatch)" Style="{StaticResource Label}"/>
            <ComboBox x:Name="ProviderCombo" SelectionChanged="ProviderCombo_SelectionChanged">
                <ComboBoxItem Content="(not configured — set up later)"/>
                <ComboBoxItem Content="anthropic" Tag="anthropic"/>
                <ComboBoxItem Content="claude-cli" Tag="claude-cli"/>
                <ComboBoxItem Content="ollama" Tag="ollama"/>
            </ComboBox>

            <TextBlock Text="Orchestrator model override (Ollama model name, or claude CLI model override — optional)" Style="{StaticResource Label}"/>
            <TextBox x:Name="ModelBox"/>

            <TextBlock Text="Builder AI provider (turns a project's BOOTSTRAP.md into architecture docs — separate from Orchestrator)" Style="{StaticResource Label}"/>
            <ComboBox x:Name="BuilderProviderCombo" SelectionChanged="BuilderProviderCombo_SelectionChanged">
                <ComboBoxItem Content="(not configured — set up later)"/>
                <ComboBoxItem Content="anthropic" Tag="anthropic"/>
                <ComboBoxItem Content="claude-cli" Tag="claude-cli"/>
                <ComboBoxItem Content="ollama" Tag="ollama"/>
            </ComboBox>

            <TextBlock Text="Builder model override (optional)" Style="{StaticResource Label}"/>
            <TextBox x:Name="BuilderModelBox"/>

            <Border x:Name="ClaudeCliPanel" Visibility="Collapsed" Background="#252526" CornerRadius="6"
                    Padding="12" Margin="0,16,0,0" BorderBrush="#3A3A3A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="claude CLI (Claude Code)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ClaudeCliStatusText" Text="Checking..." Foreground="#B0B0B0" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="InstallClaudeCliButton" Content="Install via npm" Style="{StaticResource SecondaryButton}" Click="InstallClaudeCliButton_Click"/>
                        <Button x:Name="LoginClaudeCliButton" Content="Log in" Style="{StaticResource SecondaryButton}" Click="LoginClaudeCliButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <CheckBox x:Name="AutoUpdateCheck" Content="Automatically check for Endo updates" IsChecked="True" Margin="0,16,0,0"/>

            <TextBlock x:Name="StatusMessage" Margin="0,16,0,0" Foreground="#C9524C" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
            <Button Content="Save and Continue" Padding="16,8" Background="#2B5C8A" Foreground="White"
                    BorderThickness="0" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
